{
  "expo": {
    "name": "Ndimi Swahili",
    "slug": "ndimi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ndimi.swahili"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ndimi.swahili"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-router"
      ],
      [
        "expo-sqlite"
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Ndimi records speech to translate it on device."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ndimi uses the camera to capture printed text for translation.",
          "recordAudioAndroid": false
        }
      ],
      [
        "@qvac/sdk/expo-plugin",
        {
          "installMissingPrebuilds": true
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
